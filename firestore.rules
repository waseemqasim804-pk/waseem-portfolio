rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'waseemqasim804@gmail.com';
    }

    match /{col}/{id} {
      allow read: if col in ['content', 'projects', 'services', 'awards', 'links', 'faqs', 'uses', 'timeline', 'media'];
      allow write: if isAdmin() && col in ['content', 'projects', 'services', 'awards', 'links', 'faqs', 'uses', 'timeline', 'media'];
    }

    match /availability/{id} {
      allow read, write: if isAdmin();
    }

    // Callable Functions validate Google/Facebook identity and enforce uniqueness.
    match /guestbook/{uid} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == uid)
        || resource.data.approved == true;
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /guestbookUsers/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // Cloud Functions validate and write these records; direct public writes are denied.
    match /messages/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /bookings/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /bookedSlots/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /rateLimits/{id} {
      allow read, write: if false;
    }

    match /posts/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }
  }
}
