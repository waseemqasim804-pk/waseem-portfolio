{
  "name": "portfolio-v2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "prebuild": "node scripts/check-theme-colors.mjs && node scripts/generate-sitemap.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "functions:install": "npm --prefix functions install",
    "deploy": "npm run build && npm run functions:install && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:backend": "npm run functions:install && firebase deploy --only functions,firestore:rules,firestore:indexes",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "@fontsource/pinyon-script": "^5.3.0",
    "firebase": "^11.1.0",
    "framer-motion": "^11.11.0",
    "pdfjs-dist": "4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.1.0",
    "react-router-dom": "^6.28.0",
    "simple-icons": "^16.38.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
  }
}
