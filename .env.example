# Firebase configuration — copy this file to .env and fill in your values
# Get these from: Firebase Console → Project Settings → Your Apps → Web App → Config

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Admin email (the ONLY account allowed to sign in to /admin)
VITE_ADMIN_EMAIL=waseemqasim804@gmail.com

# Canonical site URL is configured in src/config/siteConfig.json and shared by metadata and sitemap generation.
